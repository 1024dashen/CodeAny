{
  "identifier": "preview",
  "description": "Capability for preview windows loading local HTTP server",
  "windows": ["preview-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:*" }
      ]
    }
  ]
}
